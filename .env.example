DATABASE_URL=
GROWTH_ADMIN_TOKEN=
CRON_SECRET=
PUBLIC_SITE_URL=https://www.valuationhallucination.com
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=perplexity/glm-5.3-flash
# Voholabs Studio personal API key; the public API defaults to studio.voholabs.com/api.
VOHOLABS_API_KEY=
# Dedicated token allowing Muse and other agents to submit drafts, never approve or publish.
SOCIAL_AGENT_INGEST_TOKEN=
# Separate read-only token for Muse to fetch current visual briefs; not the growth admin token.
SOCIAL_AGENT_BRIEF_TOKEN=
# Used only if public Reddit RSS is unavailable; includes one paid web-search call.
PERPLEXITY_SCAN_MODEL=openai/gpt-5.6-luna
# Optional comma-separated additions. The priority launch communities are always scanned first.
REDDIT_SUBREDDITS=SideProject,EntrepreneurRideAlong,BoardgameDesign,tabletopgamedesign,playtesters,boardgames,startups,venturecapital,ProgrammerHumor,Kickstarter,Entrepreneur

# Use either a dedicated incoming webhook or the existing bot/channel pair.
GROWTH_SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
VH_SLACK_CHANNEL_ID=

# Live-market controls.
MARKET_ADMIN_TOKEN=
SLACK_SIGNING_SECRET=
